{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/gold_sniper/web/dashboard.html"
    },
    {
      "source": "/dashboard",
      "destination": "/gold_sniper/web/dashboard.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
